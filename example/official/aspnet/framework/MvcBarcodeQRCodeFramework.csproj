<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MvcBarcodeQRCodeFramework</RootNamespace>
    <AssemblyName>MvcBarcodeQRCodeFramework</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>9</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.9" />
    <PackageReference Include="Dynamsoft.DotNet.BarcodeReader.Bundle" Version="11.4.2000" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Ensure Razor Views and web content are included -->
  <ItemGroup>
    <Content Include="Views\**\*.cshtml" />
    <Content Include="Web.config" />
    <Content Include="Global.asax" />
    <Content Include="Content\**\*" />
    <Content Include="Scripts\**\*" />
  </ItemGroup>

</Project>
